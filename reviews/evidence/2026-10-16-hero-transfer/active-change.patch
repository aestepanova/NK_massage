+/* Approved portrait layout and shared booking icons, 16 October 2026. */
+.hero-layout{display:grid;grid-template-columns:minmax(0,1.17fr) minmax(0,1fr);grid-template-areas:'title person' 'description person' 'invitation person';column-gap:80px;row-gap:24px;padding-block:60px 72px;align-items:start}
+.hero-title{grid-area:title;align-self:end}
+.hero-title .eyebrow{max-width:none;color:var(--olive)}
+.hero-title h1{font-size:92px;line-height:1.2;letter-spacing:-.035em;margin-top:24px}
+.hero-title h1>span{display:block}
+.hero-title h1 em{display:block}
+.hero-description{grid-area:description;max-width:425px;font:400 14px/1.8 var(--sans);color:var(--muted);margin:0}
+.hero-person{grid-area:person;margin:0;max-width:480px;width:100%;justify-self:end}
+.hero-photo-frame{padding:6px;border:1px solid #d7dcd0;border-radius:10px;background:#fbf9f4;box-shadow:0 14px 34px rgba(35,55,45,.10)}
+.hero-person img{display:block;width:100%;height:600px;object-fit:cover;object-position:50% 48%;border-radius:4px}
+.hero-person figcaption{display:flex;justify-content:space-between;gap:20px;padding-top:17px;font:400 12px/1.6 var(--sans);color:var(--muted)}
+.hero-person figcaption>span:first-child{color:var(--ink);font-weight:500}
+.hero-invitation{grid-area:invitation;align-self:end;padding-top:7px;max-width:470px}
+.hero-price-label{font:400 12px/1.6 var(--sans);color:var(--muted)}
+.hero-price{display:flex;gap:20px;align-items:baseline;margin-top:4px}
+.hero-price strong{font:400 53px/1.1 var(--serif);letter-spacing:-.02em;white-space:nowrap}
+.hero-price span{font:400 12px/1.6 var(--sans);color:var(--muted)}
+.hero-price s{text-decoration-thickness:1px}
+.hero-invitation .button{margin-top:21px;min-width:270px}
+.cta-icon{display:block;width:16px;height:16px;flex:none}
+.button{gap:16px}
+.header-book{gap:12px}
+.session-select .cta-icon{width:18px;height:18px}
+.hero-location{font:400 12px/1.6 var(--sans);margin-top:17px;color:var(--muted);max-width:360px}
+.hero-location>span{display:block}
+.hero-first{border-top:1px solid var(--line);display:grid;grid-template-columns:1fr 1fr;gap:80px;padding-block:40px 55px}
+.hero-first-title{font:400 32px/1.2 var(--serif);letter-spacing:-.02em}
+.hero-first-copy{font:400 14px/1.8 var(--sans);color:var(--muted);max-width:480px}
+.hero-first-copy p+p{margin-top:12px}
+.approach.approach-text{display:block;padding-top:72px}
+.approach-text .approach-copy{max-width:760px;margin-inline:auto}
+.approach-text .approach-copy>p:not(.eyebrow){max-width:65ch}
+@media(max-width:1100px) and (min-width:651px){
+  .hero-layout{column-gap:40px;grid-template-columns:minmax(0,1fr) minmax(0,.9fr);padding-top:45px}
